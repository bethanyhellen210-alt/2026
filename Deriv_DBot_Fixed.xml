<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- MAIN VARIABLE DECLARATIONS -->
  <variables>
    <variable id="stake_var">Stake</variable>
    <variable id="win_stake_var">Win Stake</variable>
    <variable id="tp_var">Target Profit</variable>
    <variable id="sl_var">Stop Loss</variable>
    <variable id="ldp_var">Prediction Digit</variable>
    <variable id="mult_var">Recovery Multiplier</variable>
  </variables>

  <!-- BLOCK 1: TRADE DEFINITION (DERIV MANDATORY) -->
  <block type="trade_definition" id="trade_def_root" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_config">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_config">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_config">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_config">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_config">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- INITIALIZATION SETTINGS -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set_stk">
        <field name="VAR" id="stake_var">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="stk_num"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="variables_set" id="set_winstk">
            <field name="VAR" id="win_stake_var">Win Stake</field>
            <value name="VALUE">
              <block type="math_number" id="winstk_num"><field name="NUM">1</field></block>
            </value>
            <next>
              <block type="variables_set" id="set_tp">
                <field name="VAR" id="tp_var">Target Profit</field>
                <value name="VALUE">
                  <block type="math_number" id="tp_num"><field name="NUM">50</field></block>
                </value>
                <next>
                  <block type="variables_set" id="set_sl">
                    <field name="VAR" id="sl_var">Stop Loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="sl_num"><field name="NUM">30</field></block>
                    </value>
                    <next>
                      <block type="variables_set" id="set_ldp">
                        <field name="VAR" id="ldp_var">Prediction Digit</field>
                        <value name="VALUE">
                          <block type="math_number" id="ldp_num"><field name="NUM">6</field></block>
                        </value>
                        <next>
                          <block type="variables_set" id="set_mult">
                            <field name="VAR" id="mult_var">Recovery Multiplier</field>
                            <value name="VALUE">
                              <block type="math_number" id="mult_num"><field name="NUM">1</field></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- SUBMARKET EXECUTION OPTIONS -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="trade_options_config">
        <mutation has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <block type="math_number" id="dur_num"><field name="NUM">1</field></block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="get_stk_val">
            <field name="VAR" id="stake_var">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <block type="variables_get" id="get_ldp_val">
            <field name="VAR" id="ldp_var">Prediction Digit</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BLOCK 2: BEFORE PURCHASE -->
  <block type="before_purchase" id="before_pur_root" x="480" y="0">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="do_purchase">
        <field name="PURCHASE_LIST">DIGITMATCH</field>
      </block>
    </statement>
  </block>

  <!-- BLOCK 3: AFTER PURCHASE RECOVERY & STATS -->
  <block type="after_purchase" id="after_pur_root" x="480" y="180">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_result_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake_win">
            <field name="VAR" id="stake_var">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_winstk_val">
                <field name="VAR" id="win_stake_var">Win Stake</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="apply_recovery">
            <field name="VAR" id="stake_var">Stake</field>
            <value name="VALUE">
              <block type="math_arithmetic" id="multiply_stake">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get" id="curr_stk_get">
                    <field name="VAR" id="stake_var">Stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="mult_get">
                    <field name="VAR" id="mult_var">Recovery Multiplier</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="trade_again" id="trade_again_act"></block>
        </next>
      </block>
    </statement>
  </block>
</xml>
