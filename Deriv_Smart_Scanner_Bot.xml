<xml xmlns="https://developers.google.com/blockly/xml">
  <!-- VARIABLE DEFINITIONS -->
  <variables>
    <variable id="stake">Stake</variable>
    <variable id="initial_stake">Initial Stake</variable>
    <variable id="win_stake">Win Stake</variable>
    <variable id="target_profit">Target Profit</variable>
    <variable id="stop_loss">Stop Loss</variable>
    <variable id="total_profit">Total Profit</variable>
    <variable id="ldp">Prediction Digit</variable>
    <variable id="multiplier">Martingale Multiplier</variable>
  </variables>

  <!-- BLOCK 1: TRADE DEFINITION & MARKET PARAMETERS -->
  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_def">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="trade_type">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_type">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_candleinterval" id="interval">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_err">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- INITIALIZATION AT START -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_stake">
        <field name="VAR" id="stake">Stake</field>
        <value name="VALUE">
          <block type="math_number" id="stk_val"><field name="NUM">1</field></block>
        </value>
        <next>
          <block type="variables_set" id="init_winstake">
            <field name="VAR" id="win_stake">Win Stake</field>
            <value name="VALUE">
              <block type="math_number" id="wstk_val"><field name="NUM">1</field></block>
            </value>
            <next>
              <block type="variables_set" id="init_tp">
                <field name="VAR" id="target_profit">Target Profit</field>
                <value name="VALUE">
                  <block type="math_number" id="tp_val"><field name="NUM">50</field></block>
                </value>
                <next>
                  <block type="variables_set" id="init_sl">
                    <field name="VAR" id="stop_loss">Stop Loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="sl_val"><field name="NUM">30</field></block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_mult">
                        <field name="VAR" id="multiplier">Martingale Multiplier</field>
                        <value name="VALUE">
                          <block type="math_number" id="mult_val"><field name="NUM">1.5</field></block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_ldp">
                            <field name="VAR" id="ldp">Prediction Digit</field>
                            <value name="VALUE">
                              <block type="math_number" id="ldp_val"><field name="NUM">6</field></block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- SUB-MARKET TICK DURATION & PREDICTION OPTION -->
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="options">
        <mutation has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <block type="math_number" id="dur_val"><field name="NUM">1</field></block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="get_stake">
            <field name="VAR" id="stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <block type="variables_get" id="get_ldp">
            <field name="VAR" id="ldp">Prediction Digit</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BLOCK 2: PRE-TRADE SCANNER & PURCHASE CONDITION -->
  <block type="before_purchase" id="before_pur" x="450" y="0">
    <statement name="BEFOREPURCHASE_STACK">
      <!-- Read last digit list from tick history -->
      <block type="notify" id="scan_msg">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE">
          <block type="text_join" id="txt_join">
            <mutation items="2"></mutation>
            <value name="ADD0">
              <block type="text" id="t1"><field name="TEXT">Scanning Last Digit: </field></block>
            </value>
            <value name="ADD1">
              <block type="last_digit" id="ld_val"></block>
            </value>
          </block>
        </value>
        <next>
          <!-- Trigger Purchase Rule -->
          <block type="purchase" id="pur_action">
            <field name="PURCHASE_LIST">DIGITMATCH</field>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- BLOCK 3: AFTER PURCHASE RESULT & SMART RECOVERY BLOCK -->
  <block type="after_purchase" id="after_pur" x="450" y="320">
    <statement name="AFTERPURCHASE_STACK">
      <!-- Check if Win -->
      <block type="controls_if" id="check_win">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="res_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="notify" id="win_notif">
            <field name="NOTIFICATION_TYPE">success</field>
            <field name="NOTIFICATION_SOUND">earned-money</field>
            <value name="MESSAGE">
              <block type="text" id="w_txt"><field name="TEXT">Trade Won! Resetting Stake...</field></block>
            </value>
            <next>
              <block type="variables_set" id="reset_stk">
                <field name="VAR" id="stake">Stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_winstk">
                    <field name="VAR" id="win_stake">Win Stake</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>

        <!-- Check if Loss -> Apply Smart Multiplier Recovery -->
        <statement name="ELSE">
          <block type="notify" id="loss_notif">
            <field name="NOTIFICATION_TYPE">warn</field>
            <field name="NOTIFICATION_SOUND">loss</field>
            <value name="MESSAGE">
              <block type="text" id="l_txt"><field name="TEXT">Trade Lost! Applying Recovery Stake...</field></block>
            </value>
            <next>
              <block type="variables_set" id="apply_rec">
                <field name="VAR" id="stake">Stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="calc_stk">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <block type="variables_get" id="curr_stk">
                        <field name="VAR" id="stake">Stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="curr_mult">
                        <field name="VAR" id="multiplier">Martingale Multiplier</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>

        <!-- Check Stop Loss and Take Profit Thresholds -->
        <next>
          <block type="controls_if" id="tp_sl_check">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="chk_tp">
                <field name="OP">LT</field>
                <value name="A">
                  <block type="total_profit" id="tot_prof"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_tp">
                    <field name="VAR" id="target_profit">Target Profit</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="trade_again" id="again_action"></block>
            </statement>
            <statement name="ELSE">
              <block type="notify" id="stop_msg">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="text" id="s_txt"><field name="TEXT">Target Profit or Stop Loss Hit! Session Stopped.</field></block>
                </value>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
