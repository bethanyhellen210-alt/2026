<xml xmlns="https://developers.google.com/blockly/xml"
     is_dbot="true"
     collection="false">

  <variables>
    <variable id="bulk_enabled">bulk_enabled</variable>
    <variable id="trade_count">trade_count</variable>
    <variable id="recovery_enabled">recovery_enabled</variable>
    <variable id="recovery_level">recovery_level</variable>
    <variable id="base_stake">base_stake</variable>
    <variable id="current_stake">current_stake</variable>
    <variable id="loss_count">loss_count</variable>
    <variable id="signal_strength">signal_strength</variable>
    <variable id="selected_contract">selected_contract</variable>
    <variable id="profit_target">profit_target</variable>
    <variable id="stop_loss">stop_loss</variable>
    <variable id="ticks_collected">ticks_collected</variable>
  </variables>

  <!-- ELISY254 SCANNER PRO X
       SPECIFICATION: 1000 TICKS BEFORE FIRST TRADE
       IMPORTANT: CUSTOM BLOCK LOGIC IS NOT IMPLEMENTED
       BY THIS XML. NOT READY FOR DBOT EXECUTION.
  -->

  <trade_definition>
    <market>1HZ100V</market>
    <trade_type>OVERUNDER</trade_type>
    <duration>1</duration>
    <duration_type>TICK</duration_type>
  </trade_definition>

  <settings>
    <turbo_mode>YES</turbo_mode>
    <bulk_trade>YES</bulk_trade>
    <trade_count>3</trade_count>
    <base_stake>1</base_stake>
    <recovery>YES</recovery>
    <signal_minimum>70</signal_minimum>
    <take_profit>5</take_profit>
    <stop_loss>10</stop_loss>
  </settings>

  <scanner>
    <scan_ticks>1000</scan_ticks>
    <minimum_ticks_before_trade>1000</minimum_ticks_before_trade>
    <wait_until_scan_complete>YES</wait_until_scan_complete>
    <calculate_digit_frequency>YES</calculate_digit_frequency>
    <calculate_signal/>
    <require_signal_strength>70</require_signal_strength>
    <no_trade_without_signal>YES</no_trade_without_signal>
  </scanner>

  <contract_selector>
    <rule priority="1">
      <condition>digits_8_9_high</condition>
      <contract>UNDER8</contract>
    </rule>
    <rule priority="2">
      <condition>digits_7_8_9_high</condition>
      <contract>UNDER7</contract>
    </rule>
    <rule priority="3">
      <condition>digits_6_7_8_9_high</condition>
      <contract>UNDER6</contract>
    </rule>
    <rule priority="4">
      <condition>digits_0_1_2_high</condition>
      <contract>OVER2</contract>
    </rule>
    <rule priority="5">
      <condition>digits_0_1_2_3_4_high</condition>
      <contract>OVER4</contract>
    </rule>
  </contract_selector>

  <bulk_trading>
    <enabled>YES</enabled>
    <trades_per_batch>3</trades_per_batch>
    <require_valid_signal>YES</require_valid_signal>
    <require_completed_initial_scan>YES</require_completed_initial_scan>
  </bulk_trading>

  <recovery_levels>
    <level id="0">1</level>
    <level id="1">1.8</level>
    <level id="2">3.2</level>
    <level id="3">5.8</level>
    <level id="4">10.5</level>
    <maximum_level>4</maximum_level>
  </recovery_levels>

  <on_win>
    <reset_recovery/>
    <reset_stake/>
    <reset_loss_counter/>
  </on_win>

  <on_loss>
    <increase_recovery_level/>
    <increase_loss_counter/>
  </on_loss>

  <protection>
    <pause_after_losses>3</pause_after_losses>
    <pause_ticks>20</pause_ticks>
    <max_losses>5</max_losses>
    <profit_target>5</profit_target>
    <drawdown_limit>10</drawdown_limit>
    <stop_when_limit_reached>YES</stop_when_limit_reached>
  </protection>

  <trade_loop>
    <step>CONNECT_TO_LIVE_MARKET</step>
    <step>COLLECT_1000_TICKS</step>
    <step>CALCULATE_DIGIT_FREQUENCIES</step>
    <step>CALCULATE_SIGNAL_STRENGTH</step>
    <step>WAIT_IF_SIGNAL_INVALID</step>
    <step>SELECT_CONTRACT</step>
    <step>CHECK_RISK_LIMITS</step>
    <step>OPEN_BATCH_OF_3_TRADES</step>
    <step>CHECK_TRADE_RESULTS</step>
    <step>UPDATE_RECOVERY_LEVEL</step>
    <step>REPEAT_WHILE_WITHIN_LIMITS</step>
  </trade_loop>

</xml>
